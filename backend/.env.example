# ResearchOne Backend — local-development minimal env
#
# This file is the LOCAL DEV starter. For production deployment to the Emma
# runtime VM, copy `.env.production.example` instead — that file lists every
# secret, third-party key, and Stripe Price ID needed in production.
#
# Quickstart:
#   cp backend/.env.example backend/.env
#   # then edit values below for your local Postgres / Redis / Clerk dev keys
#
# Production deploy:
#   cp backend/.env.production.example backend/.env
#   # then fill in every <placeholder> from your secret manager

NODE_ENV=development
PORT=3001

# Database (local Postgres)
DATABASE_URL=postgresql://researchone:researchone@localhost:5432/researchone
DB_HOST=localhost
DB_PORT=5432
DB_NAME=researchone
DB_USER=researchone
DB_PASSWORD=researchone

# Redis (local)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Security — generate with `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=dev-only-change-me-min-32-chars-aaaaaaaaaaaaaaaaaa

# CORS — Vite dev server default
CORS_ORIGINS=http://localhost:5173

# Clerk — get a test instance at https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE
CLERK_SECRET_KEY=sk_test_REPLACE
CLERK_WEBHOOK_SECRET=whsec_test_REPLACE
ADMIN_USER_IDS=

# OpenRouter — required for any inference calls
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Hugging Face Inference (V2 ensemble — optional for V1-only dev)
HF_TOKEN=

# Exports directory — local-fs path, must be writable
EXPORTS_DIR=./exports

# Embedding / ingestion knobs (defaults are fine for dev)
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=20
MAX_CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE_MB=50

# Stripe — optional for dev; checkout flows are no-ops without keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/app/billing?checkout=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/app/billing?checkout=cancel

# Discovery (Tavily) — optional; runs without external discovery if unset
DISCOVERY_ENABLED=false
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com/search

# BYOK encryption key — generate with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
BYOK_ENCRYPTION_KEY=

# Parallel Monitor (Living Reports / WO-T) — optional for dev
PARALLEL_API_KEY=
PARALLEL_BASE_URL=https://api.parallel.ai
PARALLEL_MONITOR_WEBHOOK_SECRET=

# BugNote inbound webhooks (optional — see docs/integrations/bugnote-scope.md)
BUGNOTE_WEBHOOK_SECRET=
