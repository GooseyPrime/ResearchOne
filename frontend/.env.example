# Frontend environment variables for Vercel deployment
# Copy this to .env.local for local development

# Emma backend base URL (no trailing slash)
# Split deploy (Vercel UI + api.researchone.io): set both vars below to your API origin.
# Leave blank for local all-in-one dev (same-origin /api).
# Production builds (vite build) require VITE_API_BASE_URL and VITE_SOCKET_URL when the UI is deployed separately from the API.
# VITE_API_BASE_URL=https://api.researchone.io
# VITE_SOCKET_URL=https://api.researchone.io

VITE_API_BASE_URL=

# Emma backend Socket.IO URL (usually same origin as VITE_API_BASE_URL in production)
# VITE_SOCKET_URL=https://api.researchone.io
VITE_SOCKET_URL=

# Emma backend exports base URL for Atlas export downloads (optional; defaults to same-origin /exports)
# VITE_EXPORTS_BASE_URL=https://api.researchone.io
VITE_EXPORTS_BASE_URL=

# Clerk authentication (frontend)
# Get keys from https://dashboard.clerk.com → API keys (use pk_live_* / production instance on Vercel Production)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE
VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/sign-up
VITE_CLERK_AFTER_SIGN_IN_URL=/app
VITE_CLERK_AFTER_SIGN_UP_URL=/onboarding

# BugNote feedback widget (optional — see docs/integrations/bugnote-scope.md)
# VITE_BUGNOTE_ENABLED=true
# VITE_BUGNOTE_WIDGET_URL=https://cdn.bugnote.io/widget.js

# Stripe billing (frontend)
# No Stripe.js publishable key required. Checkout flows redirect to Stripe-hosted
# Checkout via server-created sessions (POST /api/billing/checkout/*); the frontend
# only needs to follow the returned checkoutUrl. Add VITE_STRIPE_PUBLISHABLE_KEY
# here only if a future feature embeds Stripe Elements / Stripe.js client-side.
